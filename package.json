{
  "name": "noodlit",
  "private": true,
  "description": "Native wrappers (Capacitor) for the Noodlit PWA in www/.",
  "scripts": {
    "ios:sync": "cap sync ios",
    "ios:open": "cap open ios",
    "assets": "node scripts/make-native-assets.mjs && capacitor-assets generate --ios",
    "capacitor:copy:after": "node scripts/stamp-native-version.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2"
  }
}
