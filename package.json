{
  "name": "noodlit",
  "private": true,
  "version": "1.0.1",
  "description": "Native wrappers (Capacitor) for the Noodlit PWA in www/. `version` is the Android app's version name.",
  "scripts": {
    "ios:sync": "cap sync ios",
    "ios:open": "cap open ios",
    "android:sync": "cap sync android",
    "android:open": "cap open android",
    "assets": "node scripts/make-native-assets.mjs && capacitor-assets generate --ios --android"
  },
  "dependencies": {
    "@capacitor-community/media": "^9.1.0",
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@capgo/capacitor-speech-recognition": "^8.6.0",
    "@revenuecat/purchases-capacitor": "^14.1.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2"
  }
}
